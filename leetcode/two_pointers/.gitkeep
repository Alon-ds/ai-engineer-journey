def pil(nums):
    j = len(nums) - 1

    for i in range(len(nums) // 2):
        if nums[i] != nums[j]:
            return False
        j -= 1

    return True



def move_zeroes(nums):
    left = 0

    for right in range(len(nums)):
        if nums[right] != 0:
            nums[left], nums[right] = nums[right], nums[left]
            left += 1

    return nums
nums = [0, 1, 0, 3, 12]

print(move_zeroes(nums))
